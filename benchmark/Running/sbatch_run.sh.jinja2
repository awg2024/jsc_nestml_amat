#!/bin/bash

#SBATCH --job-name=nestml_amat_benchmark
#SBATCH --account=gsp26
#SBATCH --partition=batch
#SBATCH --time=00:10:00

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --hint=nomultithread

#SBATCH --output={{combination["output_file"]}}
#SBATCH --error={{combination["error_file"]}}


set -e

module load Stages/2026
module load GCC/14.3.0
module load ParaStationMPI/5.13.0-1
module load CMake/3.31.8
module load nest-simulator/3.9

source /p/project1/paj2623/gray2/venvs/amat_hpc/bin/activate

which python
which python3
which pip

echo "PATH=$PATH" 
echo "VIRTUAL_ENV=${VIRTUAL_ENV:-NOT_SET}" 
which python 
which python3 
which pip 

python3 --version p
python3 -c "import sys; print('Python executable:', sys.executable)" 
python3 -c "import matplotlib; print('Matplotlib:', matplotlib.__version__); print('Location:', matplotlib.__file__)" 
python3 -c "import matplotlib.pyplot as plt; print('pyplot import OK')"

export LD_LIBRARY_PATH="${PWD}/Running/targets_amat/target:${PWD}/Running/targets_amat_optimised_cse/target:${LD_LIBRARY_PATH:-}"

export MPLBACKEND=Agg
export PYTHONUNBUFFERED=1

export OMP_PROC_BIND=TRUE
export SRUN_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK}
export PYTHON="/p/project1/paj2623/gray2/venvs/amat_hpc/bin/python3"

export PROGRAM="$PYTHON Running/brunel_nest.py \
--simulated_neuron {{ combination['simulated_neuron'] }} \
--network_scale {{ combination['network_scale'] }} \
--nodes {{ combination['nodes'] }} \
--threads {{ combination['threads'] }} \
--iteration {{ combination['iteration'] }} \
--benchmarkPath {{ combination['benchmarkPath'] }} \
--rng_seed {{ combination['rng_seed'] }} \
--simtime {{ combination['simtime'] }} \
{% if enable_profile %}--profile_run{% endif %}"

{% if enable_profile %}

PERF_DIR="{{ combination['benchmarkPath'] }}/perf"
mkdir -p "${PERF_DIR}"

COMPUTE_EVENTS="cycles,instructions,branches,branch-misses"
CACHE_EVENTS="cache-references,cache-misses,L1-dcache-loads,L1-dcache-load-misses"
TLB_EVENTS="dTLB-loads,dTLB-load-misses"


run_perf()
{
    PHASE=$1
    EVENTS=$2

    PERF_OUT="${PERF_DIR}/perf_{{ combination['simulated_neuron'] }}_${PHASE}_nodes{{ combination['nodes'] }}_scale{{ combination['network_scale'] }}_iter{{ combination['iteration'] }}_job${SLURM_JOB_ID}.csv"

    echo "========================================="
    echo "Hardware profiling enabled"
    echo "Model      : {{ combination['simulated_neuron'] }}"
    echo "Nodes      : {{ combination['nodes'] }}"
    echo "Scale      : {{ combination['network_scale'] }}"
    echo "Iteration  : {{ combination['iteration'] }}"
    echo "Phase      : ${PHASE}"
    echo "Events     : ${EVENTS}"
    echo "Perf output: ${PERF_OUT}"
    echo "========================================="

    srun perf stat \
        --no-big-num \
        -x, \
        -e "${EVENTS}" \
        -o "${PERF_OUT}" \
        -- \
        $PROGRAM
}


{% if perf_phase == "compute" %}

run_perf "compute" "${COMPUTE_EVENTS}"

{% elif perf_phase == "cache" %}

run_perf "cache" "${CACHE_EVENTS}"

{% elif perf_phase == "tlb" %}

run_perf "tlb" "${TLB_EVENTS}"

{% elif perf_phase == "all" %}

run_perf "compute" "${COMPUTE_EVENTS}"
run_perf "cache" "${CACHE_EVENTS}"
run_perf "tlb" "${TLB_EVENTS}"

{% endif %}

{% else %}

srun $PROGRAM

{% endif %}

